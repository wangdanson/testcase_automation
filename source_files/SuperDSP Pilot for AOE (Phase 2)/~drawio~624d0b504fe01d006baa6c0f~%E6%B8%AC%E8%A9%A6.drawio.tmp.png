  <diagram name="錯誤與邊界情境" id="nt2gtW9GaUh6C1-wvfz_">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 標題 -->
        <mxCell id="err_title" value="&lt;b&gt;錯誤與邊界情境&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="400" height="40" as="geometry" />
        </mxCell>
        <!-- 情境 1：無資料時匯出 -->
        <mxCell id="err_screen1" value="&lt;div style=&#39;text-align:center;padding:15px;&#39;&gt;&lt;b&gt;📸 截圖位置&lt;/b&gt;&lt;br&gt;&lt;br&gt;表格顯示「查無資料」&lt;br&gt;匯出按鈕 disabled&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d32f2f;strokeWidth=2;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="err_story1" value="&lt;b&gt;邊界情境：無資料&lt;/b&gt;&lt;hr&gt;&lt;b&gt;觸發條件：&lt;/b&gt;篩選結果為空&lt;br&gt;&lt;b&gt;匯出按鈕：&lt;/b&gt;disabled（灰色不可點）&lt;br&gt;&lt;b&gt;表格：&lt;/b&gt;顯示「時間範圍內查無資料」&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#d32f2f;&#39;&gt;❌ 不可匯出空 Excel&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFEBEE;strokeColor=#d32f2f;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=8;shadow=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="300" height="150" as="geometry" />
        </mxCell>
        <!-- 情境 2：部分 API 失敗 -->
        <mxCell id="err_screen2" value="&lt;div style=&#39;text-align:center;padding:15px;&#39;&gt;&lt;b&gt;📸 截圖位置&lt;/b&gt;&lt;br&gt;&lt;br&gt;Toast 提示：&lt;br&gt;「部分每日成效載入失敗，&lt;br&gt;請稍後再試」&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ed6c02;strokeWidth=2;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="err_story2" value="&lt;b&gt;邊界情境：部分 API 失敗&lt;/b&gt;&lt;hr&gt;&lt;b&gt;觸發條件：&lt;/b&gt;10 個 campaign 中有 2 個 daily API 失敗&lt;br&gt;&lt;br&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;4&#39; cellspacing=&#39;0&#39; style=&#39;font-size:11px;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background:#ed6c02;color:white;&#39;&gt;&lt;th&gt;策略&lt;/th&gt;&lt;th&gt;說明&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;方案 A&lt;/td&gt;&lt;td&gt;跳過失敗的，匯出成功的&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;方案 B&lt;/td&gt;&lt;td&gt;全部中止，不匯出&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b style=&#39;color:#ed6c02;&#39;&gt;⚠️ 待討論：選方案 A 或 B？&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF3E0;strokeColor=#ed6c02;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=8;shadow=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="300" height="190" as="geometry" />
        </mxCell>
        <!-- 情境 3：campaign 名稱太長 -->
        <mxCell id="err_screen3" value="&lt;div style=&#39;text-align:center;padding:15px;&#39;&gt;&lt;b&gt;📸 截圖位置&lt;/b&gt;&lt;br&gt;&lt;br&gt;Excel Sheet 名稱被截斷&lt;br&gt;「K_Com_2024 Q4 Gadgets CPD...」&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="err_story3" value="&lt;b&gt;邊界情境：Sheet 名稱過長&lt;/b&gt;&lt;hr&gt;&lt;b&gt;觸發條件：&lt;/b&gt;campaign name 超過 31 字元&lt;br&gt;&lt;b&gt;Excel 限制：&lt;/b&gt;Sheet name 最多 31 字元&lt;br&gt;&lt;b&gt;處理：&lt;/b&gt;截斷至 31 字元&lt;br&gt;&lt;b&gt;特殊字元：&lt;/b&gt;[ ] : * ? / \\ 替換為 _&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#666;&#39;&gt;ℹ️ 靜默處理，不需通知使用者&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9C4;strokeColor=#F0C000;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=8;shadow=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="520" width="300" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
