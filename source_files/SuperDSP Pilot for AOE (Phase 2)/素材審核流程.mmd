graph TB
    %% 樣式定義 - 高對比度配色
    classDef upload fill:#1565C0,stroke:#0D47A1,stroke-width:2px,color:#FFFFFF
    classDef review fill:#E65100,stroke:#BF360C,stroke-width:2px,color:#FFFFFF
    classDef auto fill:#2E7D32,stroke:#1B5E20,stroke-width:2px,color:#FFFFFF
    classDef output fill:#6A1B9A,stroke:#4A148C,stroke-width:2px,color:#FFFFFF
    classDef fail fill:#C62828,stroke:#B71C1C,stroke-width:2px,color:#FFFFFF
    classDef decision fill:#F9A825,stroke:#F57F17,stroke-width:2px,color:#000000

    %% ===== 現況流程 =====
    subgraph current["【現況】一般素材審核流程"]
        direction TB
        C1["使用者上傳素材<br/>SuperDSP / Studio"]:::upload
        C2["ODM 審核介面<br/>出現審核資訊"]:::review
        C3["AOE 人工審核<br/>決定 OneAD 產業類別"]:::review
        C4{"審核結果"}:::decision
        C5["素材審核通過"]:::auto
        C6["審核不通過<br/>需修改重傳"]:::fail
        C7["SuperDSP 廣告活動<br/>選用已審核素材"]:::upload
        C8["Sequence 產出<br/>依據 ODM 審核素材決定之產業類別"]:::output

        C1 --> C2
        C2 --> C3
        C3 --> C4
        C4 -->|通過| C5
        C4 -->|不通過| C6
        C6 -.->|重新上傳| C1
        C5 --> C7
        C7 --> C8
    end

    %% ===== 果實夥伴專屬流程 =====
    subgraph partner["【果實夥伴】簡化審核流程"]
        direction TB
        P0["Campaign Level<br/>設定 OneAD 產業類別"]:::review
        P1["OneAD-設計 上傳素材<br/>SuperDSP / Studio"]:::upload
        P2["ODM 審核介面<br/>僅顯示資訊"]:::auto
        P3["自動審核 PASS<br/>無需人工審核"]:::auto
        P4["SuperDSP 廣告活動<br/>選用素材不被卡審"]:::upload
        P5["Sequence 產出<br/>依據 Campaign Level 決定之產業類別"]:::output

        P0 --> P1
        P1 --> P2
        P2 --> P3
        P3 --> P4
        P4 --> P5
    end

    %% 流程差異標註
    subgraph legend["關鍵差異"]
        L1["審核方式<br/>人工審核 → 自動通過"]
        L2["產業類別來源<br/>素材層級 → Campaign 層級"]
        L3["流程效率<br/>需等待審核 → 即時可用"]
    end