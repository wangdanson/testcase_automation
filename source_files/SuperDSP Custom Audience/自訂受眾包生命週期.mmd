graph TB
    %% 定義樣式
    classDef segmentSystem fill:#FFF8E1,stroke:#F57C00,stroke-width:3px
    classDef superDSPSystem fill:#E8F5E9,stroke:#2E7D32,stroke-width:3px
    classDef database fill:#E3F2FD,stroke:#1976D2,stroke-width:4px
    classDef logic fill:#F3E5F5,stroke:#8E24AA,stroke-width:2px
    classDef status fill:#FFE0B2,stroke:#E65100,stroke-width:2px

    %% ============ Segment Targeting Tool 系統 (左側) ============
    subgraph SegmentTool["🟡 Segment Targeting Tool 系統"]
        direction TB
        
        subgraph Create["📦 1. 建立自訂受眾包"]
            S1[OneAD 內部人員<br/>建立自訂受眾包]:::segmentSystem
            S2[設定 Pack Name & Expiry Date]:::segmentSystem
        end
        
        subgraph WriteDB["💾 2. 寫入資料庫"]
            S3[寫入 DB.target_segments<br/>狀態: 處理中<br/>⚡ SuperDSP 立即可見]:::segmentSystem
        end
        
        subgraph DailyPack["🕐 3. 每日 01:30~05:00"]
            S4[Targeting Tool 打包 Segment]:::segmentSystem
            S5{打包結果}:::logic
            S6[更新 DB 狀態:<br/>完成/無量體]:::segmentSystem
            S7[維持 DB 狀態:<br/>處理中]:::segmentSystem
        end
        
        S1 --> S2 --> S3
        S4 --> S5
        S5 -->|成功| S6
        S5 -->|失敗| S7
    end
    
    %% ============ 共享資料庫 (中間) ============
    DB[(💾 DB.target_segments<br/><br/>欄位:<br/>• id<br/>• segment_category_id<br/>• description<br/>• oneid_qty<br/>• created_at<br/>• start_date<br/>• end_date<br/>• targeting_status)]:::database
    
    %% ============ SuperDSP 系統 (右側) ============
    subgraph SuperDSPSys["🟢 SuperDSP 系統"]
        direction TB
        
        subgraph Query["📖 1. 查詢資料"]
            D1[SQL 查詢<br/>DB.target_segments]:::superDSPSystem
        end
        
        subgraph PackList["📋 2. Custom Audience Pack List"]
            D2[顯示所有 Pack<br/>含處理中/已完成/已過期]:::superDSPSystem
        end
        
        subgraph Display["🖥️ 3. 顯示狀態"]
            D3{狀態判斷<br/>不寫 DB}:::logic
            D4["處理中<br/>→ In Processing<br/>不可綁定"]:::status
            D5["已完成<br/>→ Completed<br/>✅ 可綁定"]:::status
            D6["已過期<br/>→ Expired<br/>不可綁定"]:::status
        end
        
        subgraph Bind["🔗 4. 綁定使用"]
            D7[僅已完成狀態<br/>可綁定至 Ad Group Include]:::superDSPSystem
        end
        
        subgraph AdGroupCheck["⚠️ 5. Ad Group 狀態檢查"]
            D8{Ad Group Include<br/>是否只綁定<br/>Custom Audience?}:::logic
            D9{所有 Custom Audience<br/>是否全部已過期?}:::logic
            D10[Ad Group 狀態:<br/>上刊中 → 暫停<br/>+ Hover 提示訊息]:::status
            D11[Ad Group 維持正常]:::superDSPSystem
            D12["💬 Hover 訊息:<br/>此 Ad Group 所有自訂受眾包已過期<br/>請更新受眾包或新增其他受眾"]:::status
        end
        
        D1 --> D2 --> D3
        D3 --> D4
        D3 --> D5
        D3 --> D6
        D5 --> D7
        D7 --> D8
        D8 -->|是,只有 Custom| D9
        D8 -->|否,有其他受眾| D11
        D9 -->|是,全部過期| D10
        D9 -->|否,至少一個有效| D11
        D10 -.->|顯示| D12
    end
    
    %% ============ 系統間連接 ============
    S3 -.->|寫入| DB
    S6 -.->|寫入| DB
    S7 -.->|寫入| DB
    DB -.->|讀取| D1
    
    %% ============ 架構設計說明 ============
    subgraph Architecture["🎯 架構設計原則"]
        Arch1["1️⃣ 即時建立,立即可見<br/>Segment Tool 建立 Pack 當下寫入 DB<br/>SuperDSP 立即可查詢並顯示處理中狀態"]:::database
        
        Arch2["2️⃣ 資料庫驅動<br/>兩系統透過 DB.target_segments 溝通"]:::database
        
        Arch3["3️⃣ 單向資料流<br/>Targeting_tool (寫) → DB → SuperDSP (讀)"]:::database
        
        Arch4["4️⃣ 職責分離<br/>Targeting_tool: 建立、打包、更新<br/>SuperDSP: 查詢、顯示、判斷"]:::database
        
        Arch5["5️⃣ 無狀態回寫<br/>SuperDSP 不寫入 DB"]:::database
    end
    
    %% 設定 subgraph 樣式
    style SegmentTool fill:#FFF8E1,stroke:#F57C00,stroke-width:4px
    style SuperDSPSys fill:#E8F5E9,stroke:#2E7D32,stroke-width:4px
    style Architecture fill:#E0F2F1,stroke:#00897B,stroke-width:3px